[Unit]
Description=BookaBL FastAPI application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/bookabl
EnvironmentFile=/srv/bookabl/.env
ExecStart=/srv/bookabl/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
